import { ScrollView, Palette } from "std-widgets.slint";
import { Pal } from "theme.slint";
import { Chip, IconButton, Pill, Caption, Field } from "widgets.slint";
import { AppData, Logic, Page, ContainerRow, TabRow, GroupRow, HistoryRow, BookmarkRow, FolderRow, RuleRow } from "data.slint";
import { SettingsPage, HistoryPage, BookmarksPage, TabOptionsPage } from "pages.slint";

export { Palette, AppData, Logic, Page, ContainerRow, TabRow, GroupRow, HistoryRow, BookmarkRow, FolderRow, RuleRow }

component MenuItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    height: 48px;
    opacity: enabled ? 1 : 0.4;
    background: ta.has-hover && enabled ? Pal.surface-hi : transparent;
    border-radius: 8px;
    HorizontalLayout {
        padding-left: 12px;
        spacing: 12px;
        Text { text: root.glyph; color: Pal.accent; vertical-alignment: center; width: 24px; horizontal-alignment: center; }
        Text { text: root.label; color: Pal.text; vertical-alignment: center; }
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component UrlBar inherits Rectangle {
    in property <length> bar-height: 40px;
    height: bar-height;
    border-radius: bar-height / 2;
    background: Pal.surface;
    border-width: 1px;
    border-color: field.has-focus ? Pal.accent : Pal.border;
    callback accepted(string);
    property <bool> has-focus: field.has-focus;
    field := TextInput {
        x: 14px;
        width: parent.width - 54px;
        text: AppData.url;
        enabled: AppData.has-tab;
        color: Pal.text;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Pal.accent;
        accepted => { root.accepted(self.text); self.clear-focus(); }
    }
    if AppData.url == "" && !field.has-focus: Text {
        x: 14px;
        text: "Search or enter address";
        color: Pal.subtext;
        font-size: 14px;
        vertical-alignment: center;
    }
    IconButton {
        x: parent.width - self.width - 2px;
        y: (parent.height - self.height) / 2;
        size: root.bar-height - 6px;
        glyph: AppData.bookmarked ? "★" : "☆";
        tint: AppData.bookmarked ? Pal.accent : Pal.subtext;
        enabled: AppData.has-tab;
        clicked => { Logic.toggle-bookmark(); }
    }
}

component TabStrip inherits Flickable {
    in property <length> strip-height: 36px;
    height: strip-height;
    viewport-width: row.preferred-width;
    row := HorizontalLayout {
        spacing: 4px;
        padding-top: 2px;
        padding-bottom: 2px;
        for t in AppData.tabs: Chip {
            chip-height: root.strip-height - 4px;
            accent: t.group-color;
            selected: t.selected;
            closable: t.kind == 0;
            label: t.kind == 1 ? ((t.collapsed ? "▸ " : "▾ ") + t.title) : ((t.loading ? "… " : "") + t.title);
            clicked => { if t.kind == 1 { Logic.toggle-group(t.id); } else { Logic.select-tab(t.id); } }
            closed => { Logic.close-tab(t.id); }
        }
        IconButton { glyph: "+"; size: root.strip-height - 4px; clicked => { Logic.new-tab(); } }
    }
}

component ContainerStrip inherits Flickable {
    in property <length> strip-height: 36px;
    height: strip-height;
    viewport-width: row.preferred-width;
    row := HorizontalLayout {
        spacing: 6px;
        padding-top: 2px;
        padding-bottom: 2px;
        for c in AppData.containers: Chip {
            chip-height: root.strip-height - 4px;
            label: c.name + " · " + c.tabs;
            accent: c.color;
            selected: c.selected;
            clicked => { Logic.select-container(c.id); }
        }
    }
}

export component MainWindow inherits Window {
    title: "Cairn";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 280px;
    min-height: 240px;
    background: Pal.bg;

    property <bool> phone: self.width < 600px;
    property <bool> short: self.height < 500px;
    property <bool> compact: phone || short;
    in-out property <bool> switcher-open: false;
    in-out property <bool> menu-open: false;
    property <length> bar-h: compact ? 44px : 40px;

    Rectangle {
      x: 0px;
      y: 0px;
      width: root.width;
      height: root.height;
    VerticalLayout {
        // desktop / tablet header
        if !compact: Rectangle {
            vertical-stretch: 0;
            background: Pal.bar;
            VerticalLayout {
                padding: 6px;
                padding-bottom: 2px;
                spacing: 2px;
                ContainerStrip { }
                TabStrip { }
                HorizontalLayout {
                    spacing: 4px;
                    padding-top: 2px;
                    height: 44px;
                    IconButton { glyph: "←"; size: 38px; clicked => { Logic.back(); } }
                    IconButton { glyph: "→"; size: 38px; clicked => { Logic.forward(); } }
                    IconButton { glyph: AppData.loading ? "✕" : "⟳"; size: 38px; clicked => { Logic.reload(); } }
                    UrlBar { accepted(t) => { Logic.navigate(t); } y: 0px; bar-height: 38px; }
                    if AppData.show-shield: Text { text: "Blocked " + AppData.blocked-count; color: Pal.good; vertical-alignment: center; }
                    IconButton { glyph: "☰"; size: 38px; active: root.menu-open; clicked => { root.menu-open = !root.menu-open; } }
                }
            }
        }
        // compact top bar
        if compact: Rectangle {
            vertical-stretch: 0;
            background: Pal.bar;
            height: root.bar-h + 8px;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                if root.short: IconButton { glyph: "←"; size: root.bar-h; clicked => { Logic.back(); } }
                if root.short: IconButton { glyph: "→"; size: root.bar-h; clicked => { Logic.forward(); } }
                UrlBar { accepted(t) => { Logic.navigate(t); } bar-height: root.bar-h; }
                if root.short: IconButton { glyph: AppData.loading ? "✕" : "⟳"; size: root.bar-h; clicked => { Logic.reload(); } }
                if !root.phone || root.short: Rectangle {
                    width: root.bar-h;
                    height: root.bar-h;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Pal.border;
                    Text { text: AppData.tab-count; color: Pal.text; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.switcher-open = true; } }
                }
                if root.short: IconButton { glyph: "☰"; size: root.bar-h; clicked => { root.menu-open = !root.menu-open; } }
            }
        }
        content := Rectangle {
            background: #ffffff;
            clip: true;
            changed width => { Logic.viewport-resized(self.width, self.height); }
            changed height => { Logic.viewport-resized(self.width, self.height); }
            Image {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                source: AppData.frame;
                image-fit: fill;
                visible: AppData.has-tab;
            }
            if !AppData.has-tab: Rectangle {
                background: Pal.bg;
                Text {
                    text: AppData.status;
                    color: Pal.subtext;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            fs := FocusScope {
                capture-key-pressed(e) => { Logic.key-event(e.text, true); accept }
                key-released(e) => { Logic.key-event(e.text, false); accept }
                TouchArea {
                    moved => { Logic.pointer-moved(self.mouse-x, self.mouse-y); }
                    pointer-event(e) => {
                        fs.focus();
                        if e.kind == PointerEventKind.down {
                            Logic.pointer-pressed(self.mouse-x, self.mouse-y, e.button == PointerEventButton.left ? 0 : e.button == PointerEventButton.right ? 2 : 1);
                        } else if e.kind == PointerEventKind.up {
                            Logic.pointer-released(self.mouse-x, self.mouse-y, e.button == PointerEventButton.left ? 0 : e.button == PointerEventButton.right ? 2 : 1);
                        }
                    }
                    scroll-event(e) => {
                        Logic.scrolled(self.mouse-x, self.mouse-y, e.delta-x, e.delta-y);
                        accept
                    }
                }
            }
        }
        // phone bottom bar
        if root.phone && !root.short: Rectangle {
            vertical-stretch: 0;
            height: 52px;
            background: Pal.bar;
            HorizontalLayout {
                padding: 4px;
                IconButton { glyph: "←"; size: 44px; horizontal-stretch: 1; clicked => { Logic.back(); } }
                IconButton { glyph: "→"; size: 44px; horizontal-stretch: 1; clicked => { Logic.forward(); } }
                IconButton { glyph: AppData.loading ? "✕" : "⟳"; size: 44px; horizontal-stretch: 1; clicked => { Logic.reload(); } }
                Rectangle {
                    horizontal-stretch: 1;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 7px;
                        border-width: 2px;
                        border-color: Pal.text;
                        Text { text: AppData.tab-count; color: Pal.text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { root.switcher-open = true; } }
                }
                IconButton { glyph: "☰"; size: 44px; horizontal-stretch: 1; clicked => { root.menu-open = !root.menu-open; } }
            }
        }
    }

    }

    // pages
    if AppData.page == Page.settings: SettingsPage { x: 0; y: 0; width: root.width; height: root.height; narrow: root.phone; }
    if AppData.page == Page.history: HistoryPage { x: 0; y: 0; width: root.width; height: root.height; narrow: root.phone; }
    if AppData.page == Page.bookmarks: BookmarksPage { x: 0; y: 0; width: root.width; height: root.height; narrow: root.phone; }
    if AppData.page == Page.tab-options: TabOptionsPage { x: 0; y: 0; width: root.width; height: root.height; narrow: root.phone; }

    // menu (bottom sheet on phone, dropdown on desktop)
    if root.menu-open && AppData.page == Page.web: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        TouchArea { clicked => { root.menu-open = false; } }
        Rectangle {
            property <length> w: root.phone ? root.width : 260px;
            width: w;
            height: min(root.height - 8px, 6 * 48px + 16px);
            x: root.phone ? 0px : root.width - w - 8px;
            y: root.phone ? root.height - self.height : 56px;
            background: Pal.surface;
            border-width: 1px;
            border-color: Pal.border;
            border-radius: 12px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;
            VerticalLayout {
                padding: 8px;
                MenuItem { glyph: "🛡"; label: "Blocked this session: " + AppData.blocked-count; enabled: false; visible: AppData.show-shield; height: AppData.show-shield ? 48px : 0px; }
                MenuItem { glyph: "+"; label: "New tab"; clicked => { root.menu-open = false; Logic.new-tab(); } }
                MenuItem { glyph: "⚙"; label: "Tab options & site rule"; enabled: AppData.has-tab; clicked => { root.menu-open = false; AppData.page = Page.tab-options; } }
                MenuItem { glyph: "★"; label: "Bookmarks"; clicked => { root.menu-open = false; Logic.open-folder(0); AppData.page = Page.bookmarks; } }
                MenuItem { glyph: "↺"; label: "History"; clicked => { root.menu-open = false; Logic.history-query(""); AppData.page = Page.history; } }
                MenuItem { glyph: "⚙"; label: "Settings"; clicked => { root.menu-open = false; AppData.page = Page.settings; } }
            }
        }
    }

    // tab switcher (compact layouts)
    if root.switcher-open && AppData.page == Page.web: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Pal.bg;
        TouchArea { }
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                height: 44px;
                IconButton { glyph: "←"; size: 44px; clicked => { root.switcher-open = false; } }
                ContainerStrip { strip-height: 44px; horizontal-stretch: 1; }
                IconButton { glyph: "+"; size: 44px; clicked => { root.switcher-open = false; Logic.new-tab(); } }
            }
            ScrollView {
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    if AppData.tabs.length == 0: Caption { text: "No tabs in this container."; }
                    for t in AppData.tabs: Rectangle {
                        height: t.kind == 1 ? 40px : 56px;
                        border-radius: 8px;
                        background: t.selected ? Pal.surface-hi : Pal.surface;
                        border-width: t.grouped ? 2px : 0px;
                        border-color: t.group-color;
                        HorizontalLayout {
                            padding-left: t.grouped ? 16px : 12px;
                            Text {
                                text: t.kind == 1 ? ((t.collapsed ? "▸ " : "▾ ") + t.title) : t.title;
                                color: t.kind == 1 ? Pal.subtext : Pal.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if t.kind == 0: IconButton { glyph: "×"; size: 44px; y: 6px; tint: Pal.subtext; clicked => { Logic.close-tab(t.id); } }
                        }
                        TouchArea {
                            width: parent.width - (t.kind == 0 ? 50px : 0px);
                            clicked => {
                                if t.kind == 1 { Logic.toggle-group(t.id); } else { Logic.select-tab(t.id); root.switcher-open = false; }
                            }
                        }
                    }
                }
            }
        }
    }

    // keep overlays closed on page change
    changed width => { if !compact { root.switcher-open = false; } }
}
